{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "model": "hai-openai/gpt-6-luna"
    },
    "plan": {
      "model": "hai-openai/gpt-6.1-sol"
    },
    "title": {
      "model": "hai-openai/gpt-6-luna"
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-anthropic"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-openai"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-google"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-litellm"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "github-copilot"
      }
    ]
  },
  "model": "hai-openai/gpt-6.1-sol",
  "providers": {
    "hai-anthropic": {
      "canonical": "anthropic",
      "models": {
        "claude-haiku-4-5": {
          "limit": {
            "context": 200000,
